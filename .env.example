CREDENTIALS_PATH=credentials.json
TOKEN_PATH=token.json
MAX_EMAILS_PER_RUN=100
# Gmail search when fetching mail (pages Inbox until MAX unprocessed are found)
GMAIL_INBOX_QUERY=in:inbox

# dry_run | approval | automatic
MODE=dry_run
GMAIL_LABEL=To Process
CONFIDENCE_THRESHOLD=0.95
DATABASE_PATH=data/decisions.db

# ollama (local, default) | gemini (Google AI Studio, faster)
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Gemini — copy these into your local .env (never commit the key)
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
